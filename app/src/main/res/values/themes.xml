<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Starting window / SplashScreen: solid list-bg so task snapshot of Chat cannot flash -->
    <style name="Theme.Minima.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Minima</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Minima" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#FDFDFD</item>
        <item name="android:navigationBarColor">#FDFDFD</item>
        <item name="android:windowBackground">#FDFDFD</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
